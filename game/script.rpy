# Déclarez les personnages utilisés dans le jeu
define j = Character('Jihoon', color="#06506d")
define s = Character('Sora', color="#00a2ff")
define a = Character('Aura', color="#8400ff")
define p = Character('Professeur Kang', color="#fbff00")
define e = Character('Malo', color="#85f385")
define c = Character('Le Conservateur', color="#ffffff")
define u = Character('???', color="#ffffff")
