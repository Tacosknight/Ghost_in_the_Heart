# =====================================================================
# DÉFINITION DE L'ÉCRAN DES CRÉDITS ET DE L'ANIMATION
# =====================================================================

# 1. Animation de défilement (ATL) : monte le texte sur la durée passée en paramètre
transform credits_scroll(t=80.0):
    ypos 1.0 yanchor 0.0
    linear t ypos 0.0 yanchor 1.0

# 2. L'écran qui affiche le texte et gère le clic pour passer
screen credits_screen():
    modal True

    # Fond noir
    add "#000000"

    # Zone de texte qui défile
    vbox:
        at credits_scroll(80.0)
        xalign 0.5
        spacing 20

        text "{size=+14}{b}Ghost in the Heart{/b}{/size}" xalign 0.5
        null height 40

        text "{size=+4}{color=#00e5ff}SCÉNARIO & HISTOIRE{/color}{/size}" xalign 0.5
        text "Tacosknight72" xalign 0.5
        null height 30

        text "{size=+4}{color=#00e5ff}GRAPHISMES & DÉCORS{/color}{/size}" xalign 0.5
        text "Gemini" xalign 0.5
        null height 30

        text "{size=+4}{color=#00e5ff}MUSIQUES & SONS{/color}{/size}" xalign 0.5
        text "« Youtiful » — Stray Kids" xalign 0.5
        text "Effets sonores et autre musique : Pixabay.com" xalign 0.5
        null height 30

        text "{size=+4}{color=#00e5ff}BÊTA-TESTEURS & SOUTIENS{/color}{/size}" xalign 0.5
        text "Luffious  •  Viserion  •  Iskari" xalign 0.5
        null height 30

        text "{size=+4}{color=#00e5ff}MOTEUR DE JEU{/color}{/size}" xalign 0.5
        text "Ren'Py Engine" xalign 0.5
        null height 50

        # --- MOT DU CRÉATEUR ---
        text "{size=+4}{color=#00e5ff}NOTE DE L'AUTEUR{/color}{/size}" xalign 0.5
        null height 10

        text "{size=-2}{i}Ces derniers temps n'ont pas été faciles sur le plan moral.{/i}{/size}" xalign 0.5 text_align 0.5
        text "{size=-2}{i}Écrire cette histoire et donner vie à ces personnages m'a profondément touché,{/i}{/size}" xalign 0.5 text_align 0.5
        text "{size=-2}{i}faisant remonter des émotions parfois dures, mais aussi une vraie force d'avancer.{/i}{/size}" xalign 0.5 text_align 0.5
        null height 15

        text "{size=-2}{i}Un immense merci à mes amis d'avoir pris le temps de tester le jeu.{/i}{/size}" xalign 0.5 text_align 0.5
        text "{size=-2}{i}Et un merci tout particulier à mon père pour être venu me voir ce samedi{/i}{/size}" xalign 0.5 text_align 0.5
        text "{size=-2}{i}et m'avoir emmené en balade en centre-ville : une bouffée d'air qui m'a permis{/i}{/size}" xalign 0.5 text_align 0.5
        text "{size=-2}{i}de terminer le développement de ce projet avec un sourire sincère.{/i}{/size}" xalign 0.5 text_align 0.5
        null height 60

        text "{size=+6}MERCI D'AVOIR JOUÉ !{/size}" xalign 0.5
        null height 150

    # Raccourcis clavier pour passer les crédits
    key "K_SPACE" action Return()
    key "K_RETURN" action Return()
    key "K_ESCAPE" action Return()
    dismiss action Return()

    # Fermeture automatique à la fin des 80 secondes
    timer 80.0 action Return()